PORT=3000

# SQLite for local development (zero config)
# For production, switch the schema.prisma provider to "postgresql" and use:
#   DATABASE_URL="postgresql://user:password@localhost:5432/hotelbot"
DATABASE_URL="file:./dev.db"

# LLM Provider: openai | groq | deepseek | mistral | together | local
LLM_PROVIDER="openai"

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY="sk-..."

# Groq (used when LLM_PROVIDER=groq) — https://console.groq.com
GROQ_API_KEY="gsk_..."

# DeepSeek (used when LLM_PROVIDER=deepseek) — https://platform.deepseek.com
DEEPSEEK_API_KEY="sk-..."

# Mistral (used when LLM_PROVIDER=mistral) — https://console.mistral.ai
MISTRAL_API_KEY="..."

# Together AI (used when LLM_PROVIDER=together) — https://together.ai
TOGETHER_API_KEY="..."

# Local LLM (used when LLM_PROVIDER=local) — e.g. LM Studio, Ollama
LOCAL_LLM_API_KEY="not-needed"
LOCAL_LLM_BASE_URL="http://localhost:1234/v1"

# WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
# 1. Créez une app Meta avec le cas d'usage WhatsApp
# 2. Générez un token permanent (System User) avec les permissions:
#    - business_management
#    - whatsapp_business_messaging
#    - whatsapp_business_management
# 3. Configurez le webhook: POST https://votredomaine.com/webhook
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="123456789"
WHATSAPP_VERIFY_TOKEN="my_verify_token"

# Admin API key for dashboard access
ADMIN_API_KEY="change-me"
